; ReaSkii additions. Preserve reARK X artwork and existing layout rules.
; First-row options are independent of the stock V6 adjuster's numbered parameters.
define_parameter smart_folder_indent 'Global: Smart folder indent' 1 0 1
define_parameter tcp_name_full_row 'Track name takes the whole row' 1 0 1
define_parameter tcp_name_keep_vol '...but keep volume' 0 0 1
define_parameter tcp_name_keep_pan '...but keep pan' 0 0 1
define_parameter tcp_name_keep_info '...but keep infoblock' 0 0 1
define_parameter tcp_name_keep_io '...but keep routing button' 0 0 1
define_parameter tcp_infoblock 'TCP: Use InfoBlock' 0 0 1
define_parameter tcp_infoblock_width 'TCP: Infoblock width' 44 24 100

; Same depth curve as Reapertips: diminishing extra space, then half a unit/level.
macro reaskiiIndent out depth
    set out !smart_folder_indent depth depth<=0 0 depth==1 1 depth==2 1.75 depth==3 2.31 depth==4 2.81 depth==5 3.31 depth==6 3.81 + 3.81 * 0.5 - depth 6
endmacro

; Round unscaled indentation before applying HiDPI layout scale (float32 snap).
macro reaskiiAcc out indent units
    set out * indent units
    set out + - out 12582912 12582912
endmacro

macro reaskiiFirstRow
    set nameFullRow !tcp_name_full_row 0 ?hide_tcp.label 0 ?labelFlip 0 ?supercollapsed 0 ?mainCollapse 0 1
    set keepVol !nameFullRow 1 tcp_name_keep_vol
    set keepPan !nameFullRow 1 tcp_name_keep_pan
    set keepInfo !nameFullRow 1 tcp_name_keep_info
    set keepIO !nameFullRow 1 tcp_name_keep_io
    set infoSize !tcp_infoblock 0 tcp_infoblock_width
    set rowRoom / - main_eff * 2 tcp_padding{0} scale
    set rowRoom - . !hide_tcp.recarm 20 0
    set rowRoom - . ?hide_tcp.recmon 0 ?hide_folder_recmon 0 15
    set rowRoom - . ?keepPan !hide_pan_group + tcp_PanSize 7 0 0
    set rowRoom - . ?keepInfo ?tcp_infoblock + infoSize 7 0 0
    set rowRoom - . ?keepIO !hide_tcp.io 41 0 0
    ; Clamp a kept fader before allocating the rest to the name. Never create negative sizes.
    set maxKeptVol - rowRoom 49
    set maxKeptVol maxKeptVol<20 20
    set tcp_VolSize ?nameFullRow tcp_VolPair
    set tcp_VolSize ?nameFullRow tcp_VolSize>20 + . tcp_vol_len_offs
    set tcp_VolSize ?nameFullRow ?keepVol tcp_VolSize>maxKeptVol maxKeptVol
    set nameWidth - rowRoom ?keepVol !hide_tcp.volume tcp_VolSize 0 0
    set nameWidth - . 1
    set nameFullRow nameWidth<24 0
    set tcp_LabelSize ?nameFullRow nameWidth
    ; Even on a narrow panel, a second-row fader must leave room for both margins.
    set lateRoom / - main_eff * 2 tcp_padding{0} scale
    set tcp_VolSize ?nameFullRow !keepVol tcp_VolSize>lateRoom lateRoom
    set skipVolEarly ?nameFullRow !keepVol 1 0 0
    set skipPanEarly ?nameFullRow !keepPan 1 0 0
    set skipInfoEarly ?nameFullRow !keepInfo 1 0 0
    set skipIOEarly ?nameFullRow !keepIO 1 0 0
    set skipVolLate !skipVolEarly 1 0
    set skipPanLate !skipPanEarly 1 0
    set skipInfoLate !skipInfoEarly 1 0
    set skipIOLate !skipIOEarly 1 0
endmacro

macro reaskiiTcpFlow
    set any_row_r 0
    set first_row_r 0
    reaskiiFirstRow
    then tcp.recarm 20 0 0 0 0
    then tcp.recmon 15 0 0 hide_folder_recmon 0
    then tcp.label tcp_LabelSize 0 0 0 0
    then tcp.volume tcp_VolSize 0 0 0 skipVolEarly
    then pan_group tcp_PanSize 1 0 0 skipPanEarly
    then tcp.infoblock infoSize 1 0 !tcp_infoblock skipInfoEarly
    then tcp.io 34 1 0 0 skipIOEarly
    ; Consume the remainder so every non-kept control starts on a later row.
    set previous_element ?nameFullRow [main_sec{0} tcp_padding{1} main_eff{0} element_h{0}]
    then tcp.volume tcp_VolSize 0 0 0 skipVolLate
    then pan_group tcp_PanSize 1 0 0 skipPanLate
    then tcp.infoblock infoSize 1 0 !tcp_infoblock skipInfoLate
    then tcp.io 34 1 0 0 skipIOLate
    then fx_group 36 1 0 0 0
    then tcp.env 41 1 0 0 0
    then tcp.recmode 39 1 0 0 0
    then input_group tcp_InSize 1 1 0 0
    set tcp.infoblock.font scale==1 [1] scale==1.5 [6] [11]
    set tcp.infoblock.color [200 200 200]
    set tcp.infoblock.margin * scale [2 0 2 0]
endmacro
